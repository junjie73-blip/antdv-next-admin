{
  "extends": "@antdv/tsconfig/web.json",
  "compilerOptions": {
    // 源码只用 vue + DOM；node 类型是给 __tests__/boundary.test.ts 读目录用的（fs/path、import.meta.dirname）
    // vite/client 不能省：依赖链里的 popup-ui / common-ui 源码有 `import 'vue-sonner/style.css'` 这类副作用导入
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
