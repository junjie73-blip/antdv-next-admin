{
  "name": "@antdv/graph",
  "version": "0.2.0",
  "description": "图内核（纯 TS，无 vue / 无模板）：DAG 索引与拓扑、Tarjan 找环、结构体检，以及一套不 eval 的受限表达式求值器。工作流引擎与 AI 编排共用它的顶点/边语义",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
