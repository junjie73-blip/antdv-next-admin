{
  "name": "@antdv/design",
  "version": "0.4.0",
  "description": "设计子包：二级目录只有 token（shadcn-vue 需要的 CSS 变量，default/dark 两套主题值 + @theme inline 映射）与 css（Tailwind v4 入口的公共样式 —— 基础层、NProgress、无障碍、权限降级、滚动条兜底），入口 src/index.css 引齐两侧。边界：只写变量与 CSS，不含组件逻辑，也不感知组件库；组件自身样式随组件放在 packages/core/ui-kit/*，本包只登记它们的 Tailwind 扫描路径",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo",
    "test:unit": "vitest run"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./css/a11y.css": "./src/css/a11y.css",
    "./css/base.css": "./src/css/base.css",
    "./css/nprogress.css": "./src/css/nprogress.css",
    "./css/permission.css": "./src/css/permission.css",
    "./css/scrollbar.css": "./src/css/scrollbar.css",
    "./index.css": "./src/index.css",
    "./package.json": "./package.json",
    "./token": "./src/token/index.css",
    "./token/dark.css": "./src/token/dark.css",
    "./token/default.css": "./src/token/default.css",
    "./token/index.css": "./src/token/index.css"
  },
  "dependencies": {
    "@antdv-next/tailwind": "catalog:",
    "@tailwindcss/nesting": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "rimraf": "catalog:",
    "vitest": "catalog:"
  }
}
