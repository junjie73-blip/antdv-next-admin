{
  "name": "@antdv/design",
  "version": "0.4.0",
  "description": "设计子包：shadcn-vue 的 CSS 变量令牌（tokens.css）与公共样式 —— Tailwind v4 入口（层级顺序 / 插件 / dark 变体）、基础层、NProgress、无障碍与权限降级样式。边界：只写变量与 CSS，不含组件逻辑，也不感知组件库；组件自身样式随组件放在 packages/core/ui-kit/*，本包只登记它们的 Tailwind 扫描路径",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo",
    "test:unit": "vitest run"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./base.css": "./src/base.css",
    "./index.css": "./src/index.css",
    "./nprogress.css": "./src/nprogress.css",
    "./package.json": "./package.json",
    "./permission.css": "./src/permission.css",
    "./tokens.css": "./src/tokens.css",
    "./a11y.css": "./src/a11y.css"
  },
  "dependencies": {
    "@antdv-next/tailwind": "catalog:",
    "@tailwindcss/nesting": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "rimraf": "catalog:",
    "vitest": "catalog:"
  }
}
