{
  "name": "@antdv/shared",
  "version": "0.1.0",
  "description": "浏览器侧通用能力：缓存、色值换算、跨层常量、工具方法（cn/日期/下载/Excel/脱敏/XSS/事件）、@tanstack/vue-store 出口",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist .turbo",
    "dev": "tsdown --watch",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//exports": "子路径即模块：`@antdv/shared/utils/cn` -> dist/utils/cn.js（单文件模块走 \"./*\" 通配符，* 可含斜杠）；\ncache / color / constants / utils 及其下的 crypto / event 是多文件目录模块，\ntsdown 产出 dist/<dir>/index.js，必须显式列出才能被目录导入解析。",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "default": "./dist/color/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./utils/crypto": {
      "types": "./dist/utils/crypto/index.d.ts",
      "default": "./dist/utils/crypto/index.js"
    },
    "./utils/event": {
      "types": "./dist/utils/event/index.d.ts",
      "default": "./dist/utils/event/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/types": "workspace:*",
    "@ctrl/tinycolor": "catalog:",
    "@iconify/vue": "catalog:",
    "@tanstack/vue-store": "catalog:",
    "@vueuse/core": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "dompurify": "catalog:",
    "es-toolkit": "catalog:",
    "jose": "catalog:",
    "mitt": "catalog:",
    "sm-crypto": "catalog:",
    "spark-md5": "catalog:",
    "tailwind-merge": "catalog:",
    "theme-colors": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "xlsx": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@types/sm-crypto": "catalog:",
    "@types/spark-md5": "catalog:",
    "happy-dom": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
