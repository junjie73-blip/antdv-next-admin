{
  "name": "@antdv/icons",
  "version": "0.1.0",
  "description": "图标子包：Iconify 图标、SVG 雪碧图图标与图标选择器。边界：只组合 @antdv/shadcn-ui 原语，不引 ui-kit 上层包（否则 icons ↔ common-ui 成环）；加载遮罩与滚动条的封装见 @antdv/common-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run --passWithNoTests",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./icon": "./src/icon/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@iconify-json/ant-design": "catalog:",
    "@iconify-json/carbon": "catalog:",
    "@iconify-json/fa6-regular": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/mdi": "catalog:",
    "@iconify/vue": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
