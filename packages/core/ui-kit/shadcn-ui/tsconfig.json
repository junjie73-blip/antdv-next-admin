{
  "extends": "@antdv/tsconfig/web.json",
  "compilerOptions": {
    "paths": {
      "@antdv/shared/*": ["../../base/shared/src/*"],
      "@antdv/shadcn-ui/*": ["./src/*"]
    },
    "types": ["vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["src/components/chart"]
}
