{
  "name": "@antdv/menu-ui",
  "version": "0.4.0",
  "description": "shadcn-vue 菜单包：BasicMenu（侧栏内联菜单 / 水平菜单），数据取自 @antdv/shared/menu 模型，不依赖 pinia、vue-router",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo",
    "test:unit": "vitest run --passWithNoTests",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/common-ui": "workspace:*",
    "@antdv/icons": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@antdv/types": "workspace:*",
    "@antdv/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antdv/design": "workspace:*",
    "@antdv/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
