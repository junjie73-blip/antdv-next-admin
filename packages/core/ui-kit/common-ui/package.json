{
  "name": "@antdv/common-ui",
  "version": "0.2.0",
  "description": "公共组件层：通用展示件 + AI 对话 / 数据工作台封装 + 四个业务域能力（ai-flow / im / lowcode / report）。基础控件全部来自 @antdv/shadcn-ui；重依赖按域走独立子路径导出，宿主只为自己用到的域付出解析成本；不依赖 pinia / vue-router / 应用配置，宿主能力一律走注入或 props。",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run --passWithNoTests",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "//exports": "根入口只收「不额外拖依赖」的展示件。avatar-uploader / chunk-upload / import-export / charts 走独立子路径；ai-flow / im / lowcode / report 四个业务域同样各自独立成入口（分别带 @vue-flow、@tanstack/vue-virtual、vue-draggable-plus、frappe-gantt、@antdv/graph 等重依赖），塞进根 barrel 会让 `import { Card }` 的宿主也背上一份。\n  `./chunk-upload/upload.worker` 单独列出，是因为宿主注入哈希后端要写 `?worker` 导入。",
  "exports": {
    ".": "./src/index.ts",
    "./ai-flow": "./src/ai-flow/index.ts",
    "./im": "./src/im/index.ts",
    "./lowcode": "./src/lowcode/index.ts",
    "./report": "./src/report/index.ts",
    "./avatar-uploader": "./src/components/avatar-uploader/index.ts",
    "./charts": "./src/components/charts/index.ts",
    "./chunk-upload": "./src/components/chunk-upload/index.ts",
    "./chunk-upload/upload.worker": "./src/components/chunk-upload/upload.worker.ts",
    "./import-export": "./src/components/import-export/index.ts",
    "./package.json": "./package.json",
    "./style.css": "./src/index.css"
  },
  "dependencies": {
    "@antdv/form-ui": "workspace:*",
    "@antdv/graph": "workspace:*",
    "@antdv/icons": "workspace:*",
    "@antdv/popup-ui": "workspace:*",
    "@antdv/request": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@antdv/table-ui": "workspace:*",
    "@iconify/vue": "catalog:",
    "@lucide/vue": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-text-style": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@vue-flow/background": "catalog:",
    "@vue-flow/controls": "catalog:",
    "@vue-flow/core": "catalog:",
    "@vue-flow/minimap": "catalog:",
    "@vueuse/core": "catalog:",
    "cronstrue": "catalog:",
    "dayjs": "catalog:",
    "echarts": "catalog:",
    "es-toolkit": "catalog:",
    "frappe-gantt": "catalog:",
    "marked": "catalog:",
    "reka-ui": "catalog:",
    "spark-md5": "catalog:",
    "vue": "catalog:",
    "vue-cropper": "catalog:",
    "vue-draggable-plus": "catalog:",
    "vue-sonner": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@types/spark-md5": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
