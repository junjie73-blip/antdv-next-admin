{
  "name": "@antdv/common-ui",
  "version": "0.1.0",
  "description": "公共展示组件：卡片、标签、分隔线、间距、提示，全部基于 @antdv/shadcn-ui 的原语组合，不依赖 pinia / vue-router / 应用配置",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run --passWithNoTests",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./charts": "./src/components/charts/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/icons": "workspace:*",
    "@antdv/popup-ui": "workspace:*",
    "@antdv/request": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@iconify/vue": "catalog:",
    "@lucide/vue": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-text-style": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@vueuse/core": "catalog:",
    "cronstrue": "catalog:",
    "echarts": "catalog:",
    "es-toolkit": "catalog:",
    "marked": "catalog:",
    "reka-ui": "catalog:",
    "vue": "catalog:",
    "vue-sonner": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
