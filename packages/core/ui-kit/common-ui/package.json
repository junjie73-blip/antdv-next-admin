{
  "name": "@antdv/common-ui",
  "version": "0.1.0",
  "description": "公共展示组件：卡片、标签、分隔线、间距、提示，加上上传/头像裁剪/导入导出/更新提示这些「带自己第三方依赖」的整件，全部基于 @antdv/shadcn-ui 的原语组合，不依赖 pinia / vue-router / 应用配置（要宿主提供的判定与后端通道一律走注入或 props）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run --passWithNoTests",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "//exports": "根入口只收「不额外拖依赖」的展示件。avatar-uploader（vue-cropper）、\n  chunk-upload（spark-md5 + worker + 一整套分片协议）、import-export（xlsx 模板生成）、\n  charts（echarts 全量注册表）各走独立子路径：塞进根入口会让 `import { Card }` 的宿主\n  也付出一份裁剪器/表格库的解析成本，判据与 @antdv/hooks 的 echarts 同一条。\n  `./chunk-upload/upload.worker` 单独列出，是因为宿主注入哈希后端要写\n  `import W from '@antdv/common-ui/chunk-upload/upload.worker?worker'`，\n  而 `?worker` 也得先过 exports 这一关。",
  "exports": {
    ".": "./src/index.ts",
    "./avatar-uploader": "./src/components/avatar-uploader/index.ts",
    "./charts": "./src/components/charts/index.ts",
    "./chunk-upload": "./src/components/chunk-upload/index.ts",
    "./chunk-upload/upload.worker": "./src/components/chunk-upload/upload.worker.ts",
    "./import-export": "./src/components/import-export/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/icons": "workspace:*",
    "@antdv/popup-ui": "workspace:*",
    "@antdv/request": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@iconify/vue": "catalog:",
    "@lucide/vue": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-text-style": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@vueuse/core": "catalog:",
    "cronstrue": "catalog:",
    "echarts": "catalog:",
    "es-toolkit": "catalog:",
    "marked": "catalog:",
    "reka-ui": "catalog:",
    "spark-md5": "catalog:",
    "vue": "catalog:",
    "vue-cropper": "catalog:",
    "vue-sonner": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@types/spark-md5": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
