{
  "name": "@antdv/layout-ui",
  "version": "0.4.0",
  "description": "shadcn-vue 布局组件包：布局壳与各区渲染（Header/Sider/NavRail/Content/Breadcrumb/Footer/移动遮罩）+ 布局形态示意图，纯表现层，不依赖 pinia、vue-router、业务 store",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo",
    "test:unit": "vitest run",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/common-ui": "workspace:*",
    "@antdv/icons": "workspace:*",
    "@antdv/layouts": "workspace:*",
    "@antdv/menu-ui": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@antdv/types": "workspace:*",
    "@antdv/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antdv/design": "workspace:*",
    "@antdv/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
