{
  "name": "@antdv/layout-ui",
  "version": "0.4.0",
  "description": "shadcn-vue 布局渲染层：布局壳与五个区域（Header/Sidebar/NavRail/Tabbar/Content/Footer）+ 侧栏折叠按钮与拖拽 hook + 外壳尺寸与文案注入契约，纯表现层；形态蓝图、面包屑与示意图在 @antdv/layouts，不依赖 pinia、vue-router、业务 store",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/common-ui": "workspace:*",
    "@antdv/icons": "workspace:*",
    "@antdv/menu-ui": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@antdv/types": "workspace:*",
    "@antdv/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antdv/design": "workspace:*",
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
