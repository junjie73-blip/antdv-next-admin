{
  "name": "@antdv/tabs-ui",
  "version": "0.1.0",
  "description": "shadcn-vue 多标签页包：TabList / TabItem / TabActions / TabContextMenu 与标签宿主条，store 无关（数据与回调由使用方注入）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/common-ui": "workspace:*",
    "@antdv/icons": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@antdv/types": "workspace:*",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "sortablejs": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antdv/design": "workspace:*",
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@types/sortablejs": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
