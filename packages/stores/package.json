{
  "name": "@antdv/stores",
  "version": "0.1.0",
  "description": "会话状态子包：偏好派生视图（app）、标签页（tabs）、菜单即权限（route）、凭证与用户信息（user）、页面缓存登记表。可以用 pinia，但不 import vue-router 实例与任何 UI 库；路由与后端地址由调用方注入",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo",
    "test:unit": "vitest run",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/enums": "workspace:*",
    "@antdv/preferences": "workspace:*",
    "@antdv/request": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@antdv/types": "workspace:*",
    "@antdv/utils": "workspace:*",
    "pinia": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  }
}
