{
  "name": "@antdv/layouts",
  "version": "0.5.0",
  "description": "布局装配层：外壳装配（basic）、菜单与标签页的行为 hook（hooks）、顶栏小部件（widgets）、页面缓存（route-cached）与 7 种菜单形态的区域蓝图。状态读 @antdv/stores，路由用 vue-router 的组合式 API，文案与品牌资源由宿主注入",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run",
    "type-check": "vue-tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "//exports": "源码入口：包里有 SFC（外壳、面包屑、小部件），必须由消费方的 Vite/vitest 编译，dist 产物做不到这点。子路径给只要单一能力的场景（`@antdv/layouts/menu-search`）。",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/common-ui": "workspace:*",
    "@antdv/hooks": "workspace:*",
    "@antdv/icons": "workspace:*",
    "@antdv/layout-ui": "workspace:*",
    "@antdv/menu-ui": "workspace:*",
    "@antdv/popup-ui": "workspace:*",
    "@antdv/preferences": "workspace:*",
    "@antdv/shared": "workspace:*",
    "@antdv/shadcn-ui": "workspace:*",
    "@antdv/stores": "workspace:*",
    "@antdv/tabs-ui": "workspace:*",
    "@antdv/types": "workspace:*",
    "@antdv/utils": "workspace:*",
    "@iconify/vue": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/motion": "catalog:",
    "dayjs": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@antdv/design": "workspace:*",
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "pinia": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
