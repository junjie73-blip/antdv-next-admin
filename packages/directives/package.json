{
  "name": "@antdv/directives",
  "version": "0.4.0",
  "description": "可复用 Vue 指令：v-permission 权限控制、v-lazy 图片懒加载——判定逻辑与浏览器 API 全部通过依赖注入拿，包内不 import store / pinia / vueuse",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist .turbo",
    "dev": "tsdown --watch",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./permission": {
      "types": "./dist/permission/index.d.ts",
      "default": "./dist/permission/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "happy-dom": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
