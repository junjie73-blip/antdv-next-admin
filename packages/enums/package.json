{
  "name": "@antdv/enums",
  "version": "0.1.0",
  "description": "跨层枚举：缓存 Key、字典 TypeCode 等只含字面量的取值集合，不依赖 vue / pinia / 应用配置",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo",
    "test:unit": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
