{
  "name": "@antdv/types",
  "version": "0.4.0",
  "description": "Monorepo 共享类型契约（布局设置、菜单、标签页、Mock 信封）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist .turbo",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "antdv-next": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "antdv-next": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vue-router": "catalog:"
  }
}