{
  "name": "@antdv/utils",
  "version": "0.1.0",
  "description": "与框架无关的纯函数：菜单树/key 体系（menu）、主题模式解析与系统深色探测（theme-mode）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "//exports": "入口 barrel 之外保留两个子路径，方便只取一类能力（如只要 menu）而不把其它逻辑带进 SSR / Node 侧。",
  "exports": {
    ".": "./src/index.ts",
    "./menu": "./src/menu.ts",
    "./theme-mode": "./src/theme-mode.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/shared": "workspace:*",
    "@antdv/types": "workspace:*"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "happy-dom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-router": "catalog:"
  }
}
