{
  "name": "@antdv/utils",
  "version": "0.1.0",
  "description": "与框架无关的两类纯函数：菜单树/key 体系（menu）、把偏好落到 DOM 的读写函数与系统主题探测（css-vars / theme-mode）",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf .turbo",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "//exports": "入口 barrel 之外保留三个子路径，方便只取一类能力（如只要 menu）而不把 DOM 逻辑带进 SSR / Node 侧。",
  "exports": {
    ".": "./src/index.ts",
    "./css-vars": "./src/css-vars.ts",
    "./menu": "./src/menu.ts",
    "./theme-mode": "./src/theme-mode.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@antdv/shared": "workspace:*",
    "@antdv/types": "workspace:*"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "happy-dom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-router": "catalog:"
  }
}
