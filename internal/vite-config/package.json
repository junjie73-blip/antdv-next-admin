{
  "name": "@antdv-admin/vite-config",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "共享 Vite 配置：插件装配、分包策略、env 解析与 dev proxy（含 Nitro Mock 转发）",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist .turbo",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@antdv-admin/node-utils": "workspace:*",
    "@antdv-next/auto-import-resolver": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tomjs/vite-plugin-iconify": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "archiver": "catalog:",
    "postcss": "catalog:",
    "tinyglobby": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-console-highlight": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite-bundle-analyzer": "catalog:",
    "vite-plugin-compression2": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-env-parse": "catalog:",
    "vite-plugin-html": "catalog:",
    "vite-plugin-imagemin": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vite-plugin-performance": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vite-plugin-svg-icons": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vite-plugin-vue-layouts-next": "catalog:",
    "@pnpm/workspace.read-manifest": "catalog:",
    "@intlify/unplugin-vue-i18n": "catalog:",
    "dayjs": "catalog:"
  },
  "devDependencies": {
    "@antdv-admin/node-utils": "workspace:*",
    "@antdv-admin/tsconfig": "workspace:*",
    "@types/archiver": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-router": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:",
    "vue-router": "catalog:"
  }
}