{
  "name": "antdv-next-admin",
  "version": "0.4.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjie73-blip/antdv-next-admin.git"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm run check:builds && pnpm check:cspell",
    "check:builds": "node ./scripts/check-uniform-build.mjs",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run type-check",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "build:web": "pnpm --filter @antdv/web run build",
    "dev:web": "pnpm --filter @antdv/web run dev",
    "docs:build": "pnpm --filter @antdv/docs build",
    "docs:dev": "pnpm --filter @antdv/docs dev",
    "docs:preview": "pnpm --filter @antdv/docs preview",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "mock:fixtures": "node ./scripts/generate-mock-fixtures.mjs",
    "postinstall": "pnpm -r --filter \"./internal/**\" --filter \"./scripts/**\" run --if-present build",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "release": "pnpm run build && pnpm exec changeset publish",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test:benchmark": "vitest bench --run",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:install": "pnpm --filter @antdv/web exec playwright install",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpm dlx codemod pnpm/catalog",
    "sync-upstream": " sync-upstream"
  },
  "dependencies": {
    "@tanstack/vue-store": "catalog:"
  },
  "devDependencies": {
    "@antdv/commitlint-config": "workspace:*",
    "@antdv/eslint-config": "workspace:*",
    "@antdv/oxfmt-config": "workspace:*",
    "@antdv/oxlint-config": "workspace:*",
    "@antdv/stylelint-config": "workspace:*",
    "@antdv/turbo-run": "workspace:*",
    "@antdv/vite-config": "workspace:*",
    "@antdv/vsh": "workspace:*",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "@vue/eslint-config-typescript": "catalog:",
    "cross-env": "catalog:",
    "cz-git": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.4"
}
