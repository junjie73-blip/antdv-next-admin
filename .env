VITE_NAMESPACE=antdv-next-admin
VITE_APP_TITLE=Antdv Next Vue Admin
VITE_APP_BASE_URL=https://example.com
VITE_MOCK=true

# ==================== 日志功能配置 ====================
# 是否启用前端日志记录（开发环境默认关闭）
VITE_ENABLE_LOGGING=false
# 操作日志是否记录路由跳转
VITE_LOG_ROUTE_CHANGE=true
# 本地日志最大存储条数
VITE_LOG_MAX_ENTRIES=500
