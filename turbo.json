{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "**/.env.*local",
    "**/tsconfig*.json",
    "internal/node-utils/*.json",
    "internal/node-utils/src/**/*.ts",
    "internal/vite-config/*.json",
    "internal/vite-config/src/**/*.ts",
    "scripts/*/src/**/*.ts",
    "scripts/*/src/**/*.json"
  ],
  "ui": "stream",
  "//": "internal/vite-config 等包 exports 指向 dist，必须在消费者构建前产出；保留 ^build。form-ui/table-ui/common-ui 互相以 src 引用成环，单独改成只等 @antdv/vite-config#build，避免 Turborepo 误判依赖环。",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nitro/**", ".vitepress/dist/**"]
    },
    "@antdv/common-ui#build": {
      "dependsOn": ["@antdv/vite-config#build"],
      "outputs": ["dist/**", ".output/**", ".nitro/**", ".vitepress/dist/**"]
    },
    "@antdv/form-ui#build": {
      "dependsOn": ["@antdv/vite-config#build"],
      "outputs": ["dist/**", ".output/**", ".nitro/**", ".vitepress/dist/**"]
    },
    "@antdv/table-ui#build": {
      "dependsOn": ["@antdv/vite-config#build"],
      "outputs": ["dist/**", ".output/**", ".nitro/**", ".vitepress/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {},
    "test:unit": {},
    "test:e2e": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
