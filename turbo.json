{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "**/.env.*local",
    "**/tsconfig*.json",
    "internal/node-utils/*.json",
    "internal/node-utils/src/**/*.ts",
    "internal/vite-config/*.json",
    "internal/vite-config/src/**/*.ts",
    "scripts/*/src/**/*.ts",
    "scripts/*/src/**/*.json"
  ],
  "ui": "stream",
  "//": "workspace 包统一以 src 作为 exports 目标，构建只 externalize 依赖、不读依赖产物；internal/* 与 scripts/* 已在 postinstall 先构建。因此这里不再声明 ^build，避免 form-ui/table-ui/common-ui 互相引用时 Turborepo 误判依赖成环导致 Vercel/Netlify 构建失败。",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".output/**", ".nitro/**", ".vitepress/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {},
    "test:unit": {},
    "test:e2e": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
