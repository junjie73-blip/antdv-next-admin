VITE_ARCHIVER=true
VITE_COMPRESS=gzip
VITE_PORT= 9080
VITE_INJECT_APP_LOADING=true
VITE_PWA=true
VITE_VISUALIZER=true
VITE_MOCK=true

# ==================== 日志功能配置 ====================
# 生产环境启用前端日志记录
VITE_ENABLE_LOGGING=true
# 操作日志是否记录路由跳转
VITE_LOG_ROUTE_CHANGE=true
# 本地日志最大存储条数
VITE_LOG_MAX_ENTRIES=1000

# 缓存加密密钥（SM4，必须为 32 字符，请替换为你自己的随机密钥）
# 生成方式: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VITE_CACHE_ENCRYPT_KEY=a3f8c2d9e1b4a7c6f0e5d8b2c9a1f3e7