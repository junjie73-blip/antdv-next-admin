VITE_ARCHIVER=true
VITE_COMPRESS=gzip
VITE_PORT= 9080
VITE_INJECT_APP_LOADING=true
VITE_PWA=true
VITE_VISUALIZER=true
# 浏览器内 mock：打包进产物的 fixtures 在 fetch 出口拦截同源接口，部署出去不需要 Node mock 服务。
# 产物里没有 VITE_APP_BASE_API，接口就是站点根下的 /menus、/auth/login 这样的裸路径。
# 关掉它就得接真实后端，否则首屏取菜单/用户信息全部落空。
VITE_MOCK=true
VITE_COMPRESS=true
VITE_APP_BASE_API='/api'
# 缓存加密密钥（SM4，必须为 32 字符，请替换为你自己的随机密钥）
# 生成方式: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VITE_CACHE_ENCRYPT_KEY=a3f8c2d9e1b4a7c6f0e5d8b2c9a1f3e7