VITE_ARCHIVER=true
VITE_COMPRESS=gzip
VITE_PORT= 9080
VITE_INJECT_APP_LOADING=true
VITE_PWA=true
VITE_VISUALIZER=true
# 生产包内置浏览器内 mock：backend-mock 的响应快照已生成进 apps/web/src/mock/fixtures.json，
# 只拦截同源 /api/*，未命中的请求原样透传。静态产物部署到任意平台都不需要反代或函数配置。
# 运行时可用 ?mock=0 / ?mock=1 或 localStorage.BACKEND_MOCK_ENABLED 现场启停，无需重新构建。
VITE_MOCK=true
VITE_COMPRESS=true
VITE_APP_BASE_API='/api'
# 缓存加密密钥（SM4，必须为 32 字符，请替换为你自己的随机密钥）
# 生成方式: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VITE_CACHE_ENCRYPT_KEY=a3f8c2d9e1b4a7c6f0e5d8b2c9a1f3e7