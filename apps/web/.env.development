VITE_PORT=6080
VITE_INJECT_APP_LOADING=true
VITE_DEVTOOLS=true
# VITE_TURBO_CONSOLE=true

# 文件监听改用轮询（默认关闭）。
# 仓库放在映射盘 / 网络盘（本机是 J:）时，inotify 事件不会送达 vite：改完源码
# 服务出去的模块还是旧的，表现是"明明改了，页面没变化"。
#
# 实测结论（vite 8.3.3 + 本机 J: 映射盘）：打开这个开关**也救不回来** ——
# 配置里确实拿到了 `server.watch = { usePolling: true }`，同样的目录用 chokidar
# 直接轮询能收到 change 事件，但 dev server 的模块图始终不失效（旧模块一直服务到重启）。
# 所以这里保持注释状态：白烧 CPU 换不到 HMR。
# 可靠做法仍是改完 internal/* 或 packages/* 后 `turbo build` + 重启 dev 再验证。
# VITE_DEV_POLLING=true

# Mock：VITE_MOCK=true 时 dev server 把 /api 透传到 apps/backend-mock（Nitro）
VITE_MOCK=true
VITE_APP_BASE_API=/api
VITE_MOCK_SERVER=http://localhost:5320
