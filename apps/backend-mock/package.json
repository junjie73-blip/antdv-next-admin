{
  "name": "@antdv/backend-mock",
  "version": "0.2.0",
  "description": "基于 Nitro 的 Mock 服务：业务接口 + 运行时控制面（供 Mock 数据中心面板消费）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "dev": "cross-env MOCK_ENV=development nitro dev",
    "preview": "cross-env NODE_ENV=production MOCK_ENV=production node .output/server/index.mjs",
    "start": "cross-env NODE_ENV=production MOCK_ENV=production node .output/server/index.mjs",
    "mock:seed": "node --experimental-strip-types scripts/mock-db.mjs seed",
    "mock:reset": "node --experimental-strip-types scripts/mock-db.mjs reset",
    "mock:db:info": "node --experimental-strip-types scripts/mock-db.mjs info",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@antdv/types": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-sqlite3": "catalog:",
    "dayjs": "catalog:",
    "jose": "catalog:",
    "nitropack": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "cross-env": "catalog:",
    "h3": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
