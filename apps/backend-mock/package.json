{
  "name": "@antdv/backend-mock",
  "version": "0.4.0",
  "description": "基于 Nitro 的 Mock 服务：业务接口 + 运行时控制面（供 Mock 数据中心面板消费）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "node .output/server/index.mjs",
    "start": "node .output/server/index.mjs",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@antdv/types": "workspace:*",
    "@faker-js/faker": "catalog:",
    "dayjs": "catalog:",
    "jose": "catalog:",
    "mockjs": "catalog:",
    "nitropack": "catalog:"
  },
  "devDependencies": {
    "@antdv/tsconfig": "workspace:*",
    "@types/mockjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
